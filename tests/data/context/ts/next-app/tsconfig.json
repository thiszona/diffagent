{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": ["./src/shared/components/*"],
      "@/lib/*": ["./src/shared/lib/*"],
      "@/hooks/*": ["./src/shared/hooks/*"],
      "@/api": ["./src/shared/api"],
      "@/api/*": ["./src/shared/api/*"],
      "@/config": ["./src/shared/config"],
      "@/config/*": ["./src/shared/config/*"],
      "@/query": ["./src/shared/query"],
      "@/query/*": ["./src/shared/query/*"],
      "@/test/*": ["./src/test/*"],
      "@/i18n": ["./src/shared/i18n"],
      "@/i18n/*": ["./src/shared/i18n/*"],
      "@/icons/*": ["./src/shared/assets/icons/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
