{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"ignoreDeprecations": "5.0",
		"baseUrl": "./",
		"resolveJsonModule": true,
		"types": ["jest", "node"],
		"paths": {
			"@/*": ["./src/*"],
			"@/features/*": ["./src/features/*"],
			"@/shared/*": ["./src/shared/*"],
			"@/components/*": ["./src/shared/components/*"],
			"@/lib/*": ["./src/shared/lib/*"],
			"@/hooks/*": ["./src/shared/hooks/*"],
			"@/types/*": ["./src/shared/types/*"]
		}
	},
	"include": [
		"src/**/*",
		"assets/**/*",
		"app/**/*.ts",
		"app/**/*.tsx",
		".expo/types/**/*.ts",
		"expo-env.d.ts",
		"assets/**/*"
	],
	"exclude": ["src/**/*.stories.tsx"]
}
